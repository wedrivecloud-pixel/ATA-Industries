---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import {siteData} from "../../data/siteData";
const canSubmit=siteData.formsEnabled && !!siteData.formEndpoint;
---
<BaseLayout title="Request a Quote" description="Prepare a fabrication quote request with contact details, project requirements and drawing information for ATA Industries.">
<div class="ata" style="background: #fff">
  <Header active="contact" />
  <main id="main" tabindex="-1">
    <section aria-labelledby="q-title" style="background: var(--paper); border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="padding-top: clamp(40px, 5cqi, 72px); padding-bottom: clamp(40px, 5cqi, 64px); display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: flex-end; justify-content: space-between">
        <div style="max-width: 760px; display: flex; flex-direction: column; gap: 20px">
          <p class="eyebrow">Request a quote</p>
          <h1 id="q-title" class="disp h1">Send your drawings. Get pricing in 24–48 hours.</h1>
          <p class="lead">Tell us what you need and attach your SolidWorks or CAD files. Prefer to talk it through? Call <a href="tel:+12626295527" style="font-weight: 600">(262) 629-5527</a>.</p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px">
          <span class="badge badge-solid">ISO 9001:2015</span>
          <span class="badge" style="color: var(--steel-700)">2–3 wk lead times</span>
          <span class="badge badge-arc">Rush capacity</span>
        </div>
      </div>
    </section>

    <section style="padding-top: clamp(40px, 5cqi, 72px); padding-bottom: clamp(64px, 8cqi, 120px)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px clamp(40px, 5cqi, 80px); align-items: flex-start">

        <!-- FORM -->
        <form id="quote-form" method="post" enctype="multipart/form-data" action={canSubmit?siteData.formEndpoint:undefined} data-enquiry-form data-can-submit={canSubmit?"true":"false"} style="flex: 1.6 1 560px; display: flex; flex-direction: column; gap: 36px" aria-labelledby="q-title">
          <fieldset data-quote-step style="border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px">
            <legend class="mono" style="padding: 0; margin-bottom: 20px; color: var(--steel-600); display: flex; gap: 12px; align-items: center"><span class="step-num" style="width: 28px; height: 28px; font-size: 12px">1</span>Your contact details</legend>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr)); gap: 20px">
              <div class="field"><label for="q-name">Full name <span class="req" aria-hidden="true">*</span></label><input id="q-name" name="q-name" class="input" type="text" autocomplete="name" required=""></div>
              <div class="field"><label for="q-company">Company <span class="req" aria-hidden="true">*</span></label><input id="q-company" name="q-company" class="input" type="text" autocomplete="organization" required=""></div>
              <div class="field"><label for="q-email">Work email <span class="req" aria-hidden="true">*</span></label><input id="q-email" name="q-email" class="input" type="email" autocomplete="email" required=""></div>
              <div class="field"><label for="q-phone">Phone</label><input id="q-phone" name="q-phone" class="input" type="tel" autocomplete="tel"></div>
            </div>
          <div class="step-actions"><button type="button" class="btn btn-secondary btn-sm" data-step-next>Continue to next step</button></div></fieldset>

          <fieldset data-quote-step style="border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 20px">
            <legend class="mono" style="padding: 0; margin-bottom: 20px; color: var(--steel-600); display: flex; gap: 12px; align-items: center"><span class="step-num" style="width: 28px; height: 28px; font-size: 12px">2</span>Your project</legend>
            <div class="field">
              <label for="q-desc">Project description <span class="req" aria-hidden="true">*</span></label>
              <textarea id="q-desc" name="q-desc" class="input" required="" aria-describedby="q-desc-help" placeholder="What the part does, critical features, finish, assembly or packaging needs…"></textarea>
              <p id="q-desc-help" class="help">The more context, the faster and more accurate the quote.</p>
            </div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 20px">
              <div class="field"><label for="q-qty">Quantity / annual volume</label><input id="q-qty" name="q-qty" class="input" type="text" placeholder="e.g. 250 now, 3,000 / yr"></div>
              <div class="field">
                <label for="q-mat">Material</label>
                <div class="select-wrap">
                  <select id="q-mat" name="q-mat" class="input">
                    <option>Select a material</option>
                    <option>Carbon steel</option>
                    <option>Stainless steel</option>
                    <option>Aluminum</option>
                    <option>Other / per drawing</option>
                  </select>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                </div>
              </div>
              <div class="field"><label for="q-date">Needed-by date</label><input id="q-date" name="q-date" class="input" type="date"></div>
            </div>
          <div class="step-actions"><button type="button" class="btn btn-secondary btn-sm" data-step-next>Continue to next step</button></div></fieldset>

          <fieldset data-quote-step style="border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px">
            <legend class="mono" style="padding: 0; margin-bottom: 20px; color: var(--steel-600); display: flex; gap: 12px; align-items: center"><span class="step-num" style="width: 28px; height: 28px; font-size: 12px">3</span>Drawings &amp; CAD files</legend>
            <div class="drop" style="position: relative; padding: 32px">
              <span style="width: 56px; height: 56px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--steel-300); flex: none"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"></path></svg></span>
              <div style="flex: 1 1 240px; display: flex; flex-direction: column; gap: 4px">
                <p style="margin: 0; font-weight: 600; font-size: 17px">Drag files here or <label for="q-files" style="color: var(--arc); text-decoration: underline; cursor: pointer">browse your computer</label></p>
                <p class="help">SolidWorks (.sldprt, .sldasm, .slddrw), STEP, DXF, PDF · up to [25] MB each · [10] files max</p>
              </div>
              <input accept=".sldprt,.sldasm,.slddrw,.step,.stp,.dxf,.pdf" disabled={!canSubmit} id="q-files" name="q-files" data-selected-files-input type="file" multiple="" style="position: absolute; width: 1px; height: 1px; opacity: 0">
            </div>
            <div style="display: flex; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--steel-200); font-size: 14px">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="color: var(--steel-600)"><path d="M14 3H6v18h12V7z M14 3v4h4"></path></svg>
              <span class="mono" style="color: var(--ink); font-size: 13px">mount-bracket-rev-C.sldprt</span>
              <span class="help" style="margin-left: auto">2.4 MB</span>
              <button type="button" aria-label="Remove example file mount-bracket-rev-C.sldprt" data-remove-example style="width: 36px; height: 36px; border: 0; background: none; cursor: pointer; color: var(--steel-700)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
            </div>
          <p class="help" data-selected-files aria-live="polite"></p></fieldset>

          <div style="display: flex; flex-direction: column; gap: 16px; padding-top: 28px; border-top: 1px solid var(--steel-200)">
            <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center">
              <button disabled={!canSubmit} type="submit" class="btn btn-primary" style="min-width: 260px">Submit quote request <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></button>
              <p class="help" style="max-width: 360px">Your drawings are used only to prepare your quote. [Link to privacy policy]</p>
            </div>
          </div>
        <p class="form-status" role="status">{canSubmit?"Your details will be sent to the configured enquiry service.":"Preview form — submissions and uploads are not connected. Nothing is sent."}</p></form>

        <!-- ASIDE -->
        <aside style="flex: 1 1 360px; display: flex; flex-direction: column; gap: 24px">
          <div style="background: var(--mill); color: var(--on-dark); padding: 32px; display: flex; flex-direction: column; gap: 24px">
            <p class="mono" style="margin: 0; color: var(--arc-on-dark)">What happens next</p>
            <ol style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 22px">
              <li style="display: flex; gap: 16px"><span class="step-num" style="background: var(--arc)">01</span><div><b style="color: #fff">We review your files</b><p class="small" style="margin: 4px 0 0; color: var(--on-dark-2)">Our team checks your drawings and reaches out if anything's unclear.</p></div></li>
              <li style="display: flex; gap: 16px"><span class="step-num" style="background: #2B3239">02</span><div><b style="color: #fff">You get a quote in 24–48 hours</b><p class="small" style="margin: 4px 0 0; color: var(--on-dark-2)">Pricing and lead time, in writing.</p></div></li>
              <li style="display: flex; gap: 16px"><span class="step-num" style="background: #2B3239">03</span><div><b style="color: #fff">Parts in 2–3 weeks</b><p class="small" style="margin: 4px 0 0; color: var(--on-dark-2)">Standard lead time once approved. Rush capacity available.</p></div></li>
            </ol>
          </div>

          <div style="border: 1px solid var(--steel-200); padding: 28px; display: flex; flex-direction: column; gap: 20px">
            <div>
              <p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Call us</p>
              <a href="tel:+12626295527" style="font-family: var(--f-display); font-stretch: 80%; font-weight: 700; font-size: 32px; line-height: 1; color: var(--ink); text-decoration: none">(262) 629-5527</a>
            </div>
            <div class="ph ph-light" style="aspect-ratio: 16 / 9; align-items: center; justify-content: center; text-align: center">[Map · W352 WI-33, Hartford, WI 53027 · static image linking to Google Maps]</div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(140px, 100%), 1fr)); gap: 20px">
              <div><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Corporate office</p><p class="small" style="margin: 0">W352 WI-33<br>Hartford, WI 53027</p></div>
              <div><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Shipping &amp; receiving</p><p class="small" style="margin: 0">W352 State Highway 33<br>Hartford, WI 53027</p></div>
            </div>
            <div style="padding-top: 16px; border-top: 1px solid var(--steel-200)"><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Receiving hours</p><p class="small" style="margin: 0">Monday–Friday, 7:30 AM – 4:30 PM</p></div>
          </div>

          <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
            <div class="iso-badge">
              <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M9 17.5l5 5L25 11" fill="none" stroke="#C2410C" stroke-width="2.5"></path></svg>
              <div><b>ISO 9001:2015</b><span>Certified quality management</span></div>
            </div>
            <p class="help" style="flex: 1 1 140px">Formerly LMI Manufacturing. Same phone number.</p>
          </div>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
