---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CtaBand from "../components/CtaBand.astro";
import {designData} from "../data/Home";
const {faqs}=designData;
---
<BaseLayout title="ATA Industries home" description="Contract metal fabrication for OEMs: laser cutting, forming, welding, machining and assembly at ATA Industries in Hartford, Wisconsin.">
<div class="ata" style="background: #fff">
  <Header />
  <main id="main" tabindex="-1">

    <!-- HERO -->
    <section aria-labelledby="hero-title" style="position: relative; background: var(--mill); color: #fff; overflow: hidden">
      <div class="ph" style="position: absolute; inset: 0; align-items: flex-start; justify-content: flex-end; padding: 20px 24px">
        <span style="max-width: 300px; text-align: right">[Hero background video] 10–15 s muted loop · fiber laser, robotic weld cell, press brake · poster image first</span>
      </div>
      <div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,17,20,.94) 0%, rgba(14,17,20,.78) 48%, rgba(14,17,20,.35) 100%)"></div>
      <div class="wrap" style="position: relative; padding-top: clamp(80px, 9cqi, 150px); padding-bottom: 40px">
        <div style="max-width: 860px; display: flex; flex-direction: column; gap: 24px">
          <p class="eyebrow" style="color: var(--arc-on-dark)">Contract metal fabrication · Hartford, Wisconsin</p>
          <h1 id="hero-title" class="disp d1" style="color: #fff">Expert Metal Fabrication for OEMs Who Demand More</h1>
          <p class="lead" style="color: var(--on-dark); max-width: 640px">Laser cutting, forming, welding, machining and assembly under one roof, backed by 60+ years of fabrication experience and an ISO 9001:2015 certified quality system.</p>
          <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px">
            <a class="btn btn-primary" href="/quote/">Request a Quote <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
            <a class="btn btn-ghost-dark" href="tel:+12626295527"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2z"></path></svg>Call (262) 629-5527</a>
          </div>
          <p class="small" style="margin: 0; color: var(--on-dark-2)">Send SolidWorks or CAD files · Pricing back in 24–48 hours</p>
        </div>
        <div class="trust" style="margin-top: clamp(56px, 7cqi, 112px)">
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">60+ yrs</p><p class="stat-label" style="color: var(--on-dark-2)">Fabrication experience</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">ISO 9001</p><p class="stat-label" style="color: var(--on-dark-2)">2015 certified quality</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">24–48 hr</p><p class="stat-label" style="color: var(--on-dark-2)">Quote turnaround</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">2–3 wk</p><p class="stat-label" style="color: var(--on-dark-2)">Standard lead times</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">20%</p><p class="stat-label" style="color: var(--on-dark-2)">Capacity held for rush</p></div>
        </div>
      </div>
    </section>

    <!-- LOGO STRIP -->
    <section aria-label="Brands our parts serve" style="border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px 48px; padding-top: 32px; padding-bottom: 32px">
        <p class="mono" style="margin: 0; color: var(--steel-600); flex: 0 1 230px">Our parts run in systems used by</p>
        <div style="flex: 1 1 600px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(130px, 100%), 1fr)); gap: 12px">
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Walmart logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Coca-Cola logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Amazon logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[McDonald's logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Folgers logo]</div>
        </div>
      </div>
    </section>

    <!-- INTRO + WHY TRUST -->
    <section class="sec">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 56px clamp(40px, 6cqi, 96px)">
        <div style="flex: 1 1 460px; display: flex; flex-direction: column; gap: 24px">
          <p class="eyebrow">01 / Contract manufacturing</p>
          <h2 class="disp h2">One accountable partner, from flat sheet to finished assembly.</h2>
          <p class="lead">ATA Industries is a contract metal fabricator for OEMs. We cut, form, weld, machine and assemble in one 40,000 sq ft facility in Hartford, Wisconsin, so your parts move between processes without moving between suppliers.</p>
          <p class="body">For more than 60 years our team has built parts that end up in equipment used by Walmart, Coca-Cola, Amazon, McDonald's and Folgers. You get one quote, one PO and one point of contact.</p>
          <div class="ph" style="aspect-ratio: 16 / 10; margin-top: 8px">[Photo: ATA team reviewing a drawing at the press brake]</div>
        </div>
        <div style="flex: 1 1 420px">
          <div style="background: var(--paper); padding: clamp(28px, 3.5cqi, 48px); border-top: 3px solid var(--ink); display: flex; flex-direction: column; gap: 24px">
            <h3 class="disp h3">Why clients trust ATA Industries</h3>
            <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column">
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>ISO 9001:2015 certified</b><p class="body small" style="margin-top: 2px">A documented, audited quality system behind every job.</p></div></li>
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>60+ years of fabrication experience</b><p class="body small" style="margin-top: 2px">Proven on OEM programs from prototype to production.</p></div></li>
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>Quotes in 24–48 hours</b><p class="body small" style="margin-top: 2px">Send drawings today, have pricing within two business days.</p></div></li>
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>2–3 week lead times</b><p class="body small" style="margin-top: 2px">Standard turnaround on production orders.</p></div></li>
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>Rush capacity on hand</b><p class="body small" style="margin-top: 2px">20% of shop capacity is reserved for urgent jobs.</p></div></li>
              <li style="display: flex; gap: 16px; padding: 18px 0; border-top: 1px solid var(--steel-200); border-bottom: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 3px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><div><b>One roof, one point of contact</b><p class="body small" style="margin-top: 2px">Cutting through assembly with no supplier handoffs.</p></div></li>
            </ul>
            <a class="btn btn-secondary" href="/quote/" style="align-self: flex-start">Talk to our team</a>
          </div>
        </div>
      </div>
    </section>

    <!-- PROBLEMS -->
    <section class="sec" style="background: var(--mill); color: var(--on-dark)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow" style="color: var(--arc-on-dark)">02 / Problems we solve</p>
            <h2 class="disp h2" style="color: #fff">We fix what's holding you back.</h2>
          </div>
          <p class="lead" style="color: var(--on-dark-2); max-width: 480px">Most OEMs come to us after a supplier missed a ramp, a ship date or a spec. Here's how we keep it from happening again.</p>
        </div>
        <div class="g4" style="gap: 0; border-top: 1px solid var(--mill-line); border-left: 1px solid var(--mill-line)">
          <div style="padding: 32px 28px; border-right: 1px solid var(--mill-line); border-bottom: 1px solid var(--mill-line); display: flex; flex-direction: column; gap: 14px">
            <p class="mono" style="margin: 0; color: var(--on-dark-2)">A · The problem</p>
            <h3 class="disp h3" style="color: #fff">Slow ramp-up</h3>
            <p class="body" style="color: var(--on-dark-2)">New programs stall waiting on prototypes and first articles.</p>
            <div class="rule-dark" style="margin: 8px 0"></div>
            <p class="mono" style="margin: 0; color: var(--arc-on-dark)">Our fix</p>
            <p class="body" style="color: var(--on-dark)">Prototypes and production run on the same equipment with the same team, so what you approve is what we build at volume.</p>
          </div>
          <div style="padding: 32px 28px; border-right: 1px solid var(--mill-line); border-bottom: 1px solid var(--mill-line); display: flex; flex-direction: column; gap: 14px">
            <p class="mono" style="margin: 0; color: var(--on-dark-2)">B · The problem</p>
            <h3 class="disp h3" style="color: #fff">Long lead times</h3>
            <p class="body" style="color: var(--on-dark-2)">Parts arrive weeks after your line needed them.</p>
            <div class="rule-dark" style="margin: 8px 0"></div>
            <p class="mono" style="margin: 0; color: var(--arc-on-dark)">Our fix</p>
            <p class="body" style="color: var(--on-dark)">2–3 week standard lead times, with 20% of capacity held open for rush jobs.</p>
          </div>
          <div style="padding: 32px 28px; border-right: 1px solid var(--mill-line); border-bottom: 1px solid var(--mill-line); display: flex; flex-direction: column; gap: 14px">
            <p class="mono" style="margin: 0; color: var(--on-dark-2)">C · The problem</p>
            <h3 class="disp h3" style="color: #fff">Inconsistent quality</h3>
            <p class="body" style="color: var(--on-dark-2)">Rejected parts, rework and surprise NCRs.</p>
            <div class="rule-dark" style="margin: 8px 0"></div>
            <p class="mono" style="margin: 0; color: var(--arc-on-dark)">Our fix</p>
            <p class="body" style="color: var(--on-dark)">An ISO 9001:2015 certified quality system and certified manual and robotic welders.</p>
          </div>
          <div style="padding: 32px 28px; border-right: 1px solid var(--mill-line); border-bottom: 1px solid var(--mill-line); display: flex; flex-direction: column; gap: 14px">
            <p class="mono" style="margin: 0; color: var(--on-dark-2)">D · The problem</p>
            <h3 class="disp h3" style="color: #fff">Rising cost</h3>
            <p class="body" style="color: var(--on-dark-2)">Every handoff between suppliers adds freight, markup and delay.</p>
            <div class="rule-dark" style="margin: 8px 0"></div>
            <p class="mono" style="margin: 0; color: var(--arc-on-dark)">Our fix</p>
            <p class="body" style="color: var(--on-dark)">Cutting, forming, welding, machining and assembly in one facility, on one PO.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CAPABILITIES -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">03 / Core capabilities</p>
            <h2 class="disp h2">Every process your part needs, under one roof.</h2>
          </div>
          <a class="link-arrow" href="/quote/">View all services <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </div>
        <div class="g5">
          <a class="card" href="/services/laser-cutting/">
            <div class="ph" style="aspect-ratio: 4 / 3">[Photo: fiber laser mid-cut]</div>
            <div class="card-body">
              <span class="mono" style="color: var(--steel-600)">01</span>
              <h3 class="disp h4">Laser Cutting</h3>
              <p class="body small">Fast, clean cuts on sheet and plate with a 6kW fiber laser.</p>
              <p class="spec">6kW fiber · 79″ × 158″ bed</p>
              <span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </div>
          </a>
          <a class="card" href="/services/#forming">
            <div class="ph" style="aspect-ratio: 4 / 3">[Photo: press brake forming]</div>
            <div class="card-body">
              <span class="mono" style="color: var(--steel-600)">02</span>
              <h3 class="disp h4">Forming &amp; Bending</h3>
              <p class="body small">Press brake forming for consistent, repeatable angles.</p>
              <p class="spec">28–350 ton · ±0.005″</p>
              <span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </div>
          </a>
          <a class="card" href="/services/#welding">
            <div class="ph" style="aspect-ratio: 4 / 3">[Photo: robotic weld cell]</div>
            <div class="card-body">
              <span class="mono" style="color: var(--steel-600)">03</span>
              <h3 class="disp h4">Welding</h3>
              <p class="body small">Certified manual and robotic welding for structural and cosmetic work.</p>
              <p class="spec">Up to 1″ thick · manual + robotic</p>
              <span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </div>
          </a>
          <a class="card" href="/services/#machining">
            <div class="ph" style="aspect-ratio: 4 / 3">[Photo: CNC machining]</div>
            <div class="card-body">
              <span class="mono" style="color: var(--steel-600)">04</span>
              <h3 class="disp h4">CNC Machining</h3>
              <p class="body small">Machined features, holes and tight-fit components.</p>
              <p class="spec">HAAS · Milltronics · CNC lathe</p>
              <span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </div>
          </a>
          <a class="card" href="/services/#assembly">
            <div class="ph" style="aspect-ratio: 4 / 3">[Photo: assembly line]</div>
            <div class="card-body">
              <span class="mono" style="color: var(--steel-600)">05</span>
              <h3 class="disp h4">Assembly</h3>
              <p class="body small">Sub-assemblies to finished units, ready for your line.</p>
              <p class="spec">In-house assembly &amp; staging</p>
              <span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- INDUSTRIES -->
    <section class="sec" style="background: var(--paper)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">04 / Industries served</p>
            <h2 class="disp h2">Built for the industries that keep things running.</h2>
          </div>
          <a class="link-arrow" href="/quote/">All industries <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </div>
        <div class="g4">
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: switchgear / power distribution]</div><span class="ind-name">Electrical &amp; Power Distribution <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/industries/data-centers/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: data center infrastructure]</div><span class="ind-name">Data Centers <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: stainless food equipment]</div><span class="ind-name">Food Processing <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: industrial machine frame]</div><span class="ind-name">Industrial Machinery <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: conveyor / logistics]</div><span class="ind-name">Material Handling &amp; Logistics <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: agricultural equipment]</div><span class="ind-name">Agriculture <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 10">[Photo: OEM assemblies]</div><span class="ind-name">OEM <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a href="/quote/" style="background: var(--ink); color: #fff; text-decoration: none; padding: 28px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 240px">
            <span class="mono" style="color: var(--arc-on-dark)">Not listed?</span>
            <span style="display: flex; flex-direction: column; gap: 12px">
              <span class="disp h3" style="color: #fff">If it's made from sheet, plate or structural metal, ask us.</span>
              <span style="display: inline-flex; gap: 8px; align-items: center; font-weight: 600">Talk to our team <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- WHY OEMs -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">05 / Why OEMs choose ATA Industries</p>
            <h2 class="disp h2">Numbers your purchasing team can plan around.</h2>
          </div>
          <a class="btn btn-primary" href="/quote/">Request a Quote</a>
        </div>
        <div class="g3" style="gap: 48px 40px">
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 10px"></div><p class="stat-num" style="font-size: clamp(44px, 4.4cqi, 64px)">24–48 hr</p><p class="stat-label">Quote turnaround</p><p class="body">Send drawings and get pricing back within two business days.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 10px"></div><p class="stat-num" style="font-size: clamp(44px, 4.4cqi, 64px)">2–3 wk</p><p class="stat-label">Standard lead time</p><p class="body">Production orders ship on a schedule you can build a plan around.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 10px"></div><p class="stat-num" style="font-size: clamp(44px, 4.4cqi, 64px); color: var(--arc)">20%</p><p class="stat-label">Capacity reserved for rush</p><p class="body">Urgent orders get a slot without waiting in line behind scheduled work.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 10px"></div><p class="stat-num" style="font-size: clamp(44px, 4.4cqi, 64px)">60+ yrs</p><p class="stat-label">Fabrication experience</p><p class="body">Decades of OEM work across power, food, logistics and machinery.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 10px"></div><p class="stat-num" style="font-size: clamp(44px, 4.4cqi, 64px)">ISO 9001</p><p class="stat-label">2015 certified</p><p class="body">A documented, externally audited quality management system.</p></div>
