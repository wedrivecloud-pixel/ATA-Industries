---
import PageLayout from '../../layouts/PageLayout.astro';import CTA from '../../components/CTA.astro';import {capabilities} from '../../data/capabilities';
export function getStaticPaths(){return capabilities.map(service=>({params:{slug:service.slug},props:{service}}));}
const {service}=Astro.props;
---
<PageLayout title={service.title} description={`Explore ${service.title.toLowerCase()}, potential applications and design considerations. Proposed ATA Industries service; availability requires confirmation.`}>
<section class="wrap section split"><div><p class="eyebrow">Proposed manufacturing process</p><h1>{service.title}</h1><p class="lead">{service.tagline}</p><a class="button" href={'/request-a-quote/?service='+service.slug}>Discuss this process →</a></div><figure><img src="/images/manufacturing-study.svg" alt={`Temporary concept illustration for ${service.title}; not ATA equipment or work`} width="800" height="600" /><figcaption>Concept illustration · Not a photograph of ATA equipment.</figcaption></figure></section>
<section class="wrap section prose-section"><p class="eyebrow">Process overview</p><h2>How it works.</h2><p class="lead">{service.description}</p><p class="note">Proposed service — ATA Industries capability and availability have not been verified. No equipment, tolerance, capacity or certification claims are made.</p><ol class="steps">{service.process.map((p,i)=><li><span class="step-no">0{i+1}</span><h3>{p}</h3></li>)}</ol></section>
<section class="surface section"><div class="wrap split"><div><h2>Potential applications</h2><ul class="bullet-list">{service.applications.map(a=><li>{a}</li>)}</ul><p>These are general process applications, not completed ATA Industries projects.</p></div><div><h2>Design considerations</h2><ul class="bullet-list">{service.considerations.map(c=><li>{c}</li>)}</ul><h3>General benefits</h3><p>A suitable process can support repeatability and efficient production. Results depend on the design, setup, material and agreed inspection plan.</p></div></div></section>
<section class="wrap section"><h2>Explore related processes.</h2><div class="related">{capabilities.filter(c=>c.slug!==service.slug).map(c=><a href={c.href}>{c.title} →</a>)}</div></section><CTA /></PageLayout>
