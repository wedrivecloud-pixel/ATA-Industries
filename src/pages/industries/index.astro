---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<BaseLayout title="Industries served" description="Explore fabrication applications for electrical, data center, industrial machinery, food processing, agriculture and OEM projects.">
<div class="ata" style="background: #fff">
  <Header active="industries" />
  <main id="main" tabindex="-1">
    <section aria-labelledby="inds-title" style="background: var(--mill); color: #fff">
      <div class="wrap" style="padding-top: 28px; padding-bottom: clamp(48px, 6cqi, 88px)">
        <nav aria-label="Breadcrumb"><ol class="crumbs" style="color: var(--on-dark-2)"><li><a href="/" style="color: var(--on-dark-2)">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color: #fff">Industries</li></ol></nav>
        <div style="max-width: 820px; display: flex; flex-direction: column; gap: 22px; padding-top: clamp(40px, 5cqi, 72px)">
          <p class="eyebrow" style="color: var(--arc-on-dark)">Industries served</p>
          <h1 id="inds-title" class="disp h1" style="color: #fff">Fabrication for the industries that keep things running.</h1>
          <p class="lead" style="color: var(--on-dark-2)">Low- to mid-volume, high-mix work for OEMs in power, data, food, logistics, machinery and agriculture. Our parts end up in systems used by Walmart, Coca-Cola, Amazon, McDonald's and Folgers.</p>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(380px, 100%), 1fr)); gap: 24px">
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: power distribution equipment]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="electrical">Electrical &amp; Power Distribution <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Fabricated parts and assemblies for electrical OEMs that are outsourcing more of their fabrication.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/industries/data-centers/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: data center infrastructure]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px">Data Centers <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Enclosures, frames and panels for fast-moving buildouts, with rush capacity on hand.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: food processing equipment]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="food-processing">Food Processing &amp; Packaging <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Since building the first U.S. tumbler in 1985, we've fabricated for food production equipment makers.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: industrial machine frame]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="industrial-machinery">Industrial Machinery <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Frames, guards and weldments for machine builders, from prototype to production.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: conveyor system]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="material-handling">Material Handling &amp; Logistics <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Conveyor and logistics components for systems running in Amazon and Walmart operations.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: agricultural equipment]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="agriculture">Agriculture &amp; Dirt Movement <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Where we started in 1960: building equipment to make life easier for local farmers.</p><p class="spec">[Typical parts]</p></div></a>
          <a class="ind-tile" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: OEM assemblies]</div><div style="padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px"><span class="ind-name" style="padding: 0; min-height: 0; font-size: 20px" id="oem">OEM <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span><p class="body small">Contract fabrication for OEMs and fabricators who need overflow capacity or a full-service partner.</p><p class="spec">[Typical parts]</p></div></a>
          <a href="/quote/" style="background: var(--ink); color: #fff; text-decoration: none; padding: 32px; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; min-height: 280px">
            <span class="mono" style="color: var(--arc-on-dark)">Not listed?</span>
            <span style="display: flex; flex-direction: column; gap: 14px">
              <span class="disp h3" style="color: #fff">If it's made from sheet, plate or structural metal, ask us.</span>
              <span style="display: inline-flex; gap: 8px; align-items: center; font-weight: 600">Talk to our team <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <section style="border-top: 1px solid var(--steel-200); border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; align-items: center; gap: 20px 48px; padding-top: 32px; padding-bottom: 32px">
        <p class="mono" style="margin: 0; color: var(--steel-600); flex: 0 1 230px">Our parts run in systems used by</p>
        <div style="flex: 1 1 600px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(130px, 100%), 1fr)); gap: 12px">
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Walmart logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Coca-Cola logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Amazon logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[McDonald's logo]</div>
          <div style="height: 56px; display: flex; align-items: center; justify-content: center; border: 1px dashed var(--steel-300); font-family: var(--f-mono); font-size: 12px; color: var(--steel-600)">[Folgers logo]</div>
        </div>
      </div>
    </section>
  </main>
  <CtaBand />
  <Footer />
</div>
</BaseLayout>
