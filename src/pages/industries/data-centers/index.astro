---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CtaBand from "../../../components/CtaBand.astro";
import {designData} from "../../../data/Industry-DataCenters";
const {faqs}=designData;
---
<BaseLayout title="Data Centers industry" description="Explore fabricated enclosures, frames, panels, brackets and assemblies for data center infrastructure.">
<div class="ata" style="background: #fff">
  <Header active="industries" />
  <main id="main" tabindex="-1">

    <!-- HERO -->
    <section aria-labelledby="ind-title" style="position: relative; background: var(--mill); color: #fff; overflow: hidden">
      <div class="ph" style="position: absolute; inset: 0; align-items: flex-start; justify-content: flex-end; padding: 20px 24px"><span style="max-width: 280px; text-align: right">[Hero photo: data center enclosures or racks built from ATA parts]</span></div>
      <div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(14,17,20,.94) 0%, rgba(14,17,20,.8) 50%, rgba(14,17,20,.4) 100%)"></div>
      <div class="wrap" style="position: relative; padding-top: 28px; padding-bottom: 40px">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs" style="color: var(--on-dark-2)">
            <li><a href="/" style="color: var(--on-dark-2)">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/quote/" style="color: var(--on-dark-2)">Industries</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" style="color: #fff">Data Centers</li>
          </ol>
        </nav>
        <div style="max-width: 820px; display: flex; flex-direction: column; gap: 24px; padding-top: clamp(56px, 7cqi, 112px)">
          <p class="eyebrow" style="color: var(--arc-on-dark)">Industry · Data Centers</p>
          <h1 id="ind-title" class="disp h1" style="color: #fff">Metal fabrication for data center infrastructure.</h1>
          <p class="lead" style="color: var(--on-dark); max-width: 620px">Buildouts move fast and every rack, frame and enclosure has to fit the first time. We cut, form, weld and assemble to your drawings with 2–3 week lead times.</p>
          <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px">
            <a class="btn btn-primary" href="/quote/">Request a Quote <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
            <a class="btn btn-ghost-dark" href="tel:+12626295527">Call (262) 629-5527</a>
          </div>
        </div>
        <div class="trust" style="margin-top: clamp(48px, 6cqi, 96px)">
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">ISO 9001</p><p class="stat-label" style="color: var(--on-dark-2)">2015 certified quality</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">24–48 hr</p><p class="stat-label" style="color: var(--on-dark-2)">Quote turnaround</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">2–3 wk</p><p class="stat-label" style="color: var(--on-dark-2)">Standard lead times</p></div>
          <div><div class="rule-dark" style="margin-bottom: 18px"></div><p class="stat-num">20%</p><p class="stat-label" style="color: var(--on-dark-2)">Capacity held for rush</p></div>
        </div>
      </div>
    </section>

    <!-- CHALLENGES -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Challenges we solve</p>
            <h2 class="disp h2">Data center programs can't wait on a supplier.</h2>
          </div>
          <p class="body" style="max-width: 440px">[One or two sentences on the data center OEMs ATA Industries supports: what they build, and where ATA fits in their supply chain.]</p>
        </div>
        <div class="g2" style="gap: 0; border-top: 1px solid var(--steel-200)">
          <div style="display: flex; gap: 24px; padding: 32px 32px 32px 0; border-bottom: 1px solid var(--steel-200)">
            <span class="step-num">01</span>
            <div style="display: flex; flex-direction: column; gap: 8px"><h3 class="disp h4">Compressed buildout schedules</h3><p class="body">Standard 2–3 week lead times, plus 20% of capacity reserved for rush orders when a site deadline moves up.</p></div>
          </div>
          <div style="display: flex; gap: 24px; padding: 32px 32px 32px 0; border-bottom: 1px solid var(--steel-200)">
            <span class="step-num">02</span>
            <div style="display: flex; flex-direction: column; gap: 8px"><h3 class="disp h4">Repeatability across high volumes</h3><p class="body">Part 1,000 has to match part 1. Our ISO 9001:2015 system documents how every job is built and inspected.</p></div>
          </div>
          <div style="display: flex; gap: 24px; padding: 32px 32px 32px 0; border-bottom: 1px solid var(--steel-200)">
            <span class="step-num">03</span>
            <div style="display: flex; flex-direction: column; gap: 8px"><h3 class="disp h4">Large panels and frames</h3><p class="body">A 79″ × 158″ fiber laser bed and certified welding up to 1″ thick cover large enclosure and structural parts.</p></div>
          </div>
          <div style="display: flex; gap: 24px; padding: 32px 32px 32px 0; border-bottom: 1px solid var(--steel-200)">
            <span class="step-num">04</span>
            <div style="display: flex; flex-direction: column; gap: 8px"><h3 class="disp h4">Too many suppliers per assembly</h3><p class="body">Cutting, forming, welding, machining and assembly in one facility, on one PO, with one point of contact.</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- TYPICAL PARTS -->
    <section class="sec" style="background: var(--paper)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Typical parts we produce</p>
            <h2 class="disp h2">From brackets to complete enclosures.</h2>
          </div>
          <p class="help" style="max-width: 360px">[Confirm this part list against real data center jobs before launch.]</p>
        </div>
        <div class="g3">
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Enclosures &amp; cabinets</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Rack &amp; frame components</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Cable management &amp; trays</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Brackets &amp; mounting hardware</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Panels, doors &amp; covers</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
          <figure class="card" style="margin: 0"><div class="ph" style="aspect-ratio: 16 / 10">[Photo]</div><figcaption class="card-body"><h3 class="disp h4">Power distribution components</h3><p class="spec" style="margin-top: 0">[Material · typical size]</p></figcaption></figure>
        </div>
      </div>
    </section>

    <!-- RELEVANT SERVICES -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Relevant services</p>
            <h2 class="disp h2">Every process these parts need.</h2>
          </div>
          <a class="link-arrow" href="/quote/">All services <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </div>
        <div class="g5">
          <a class="card" href="/services/laser-cutting/"><div class="card-body"><span class="mono" style="color: var(--steel-600)">01</span><h3 class="disp h4">Laser Cutting</h3><p class="spec">6kW fiber · 79″ × 158″</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/quote/"><div class="card-body"><span class="mono" style="color: var(--steel-600)">02</span><h3 class="disp h4">Forming &amp; Bending</h3><p class="spec">[Tonnage · bed length]</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/services/#welding"><div class="card-body"><span class="mono" style="color: var(--steel-600)">03</span><h3 class="disp h4">Welding</h3><p class="spec">Up to 1″ · manual + robotic</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/services/#machining"><div class="card-body"><span class="mono" style="color: var(--steel-600)">04</span><h3 class="disp h4">CNC Machining</h3><p class="spec">[Machines · envelope]</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/services/#assembly"><div class="card-body"><span class="mono" style="color: var(--steel-600)">05</span><h3 class="disp h4">Assembly</h3><p class="spec">[Hardware · kitting]</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
        </div>
      </div>
    </section>

    <!-- QUALITY CALLOUT -->
    <section style="background: var(--mill-2); color: var(--on-dark)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6cqi, 96px); align-items: center; padding-top: clamp(56px, 6cqi, 96px); padding-bottom: clamp(56px, 6cqi, 96px)">
        <div style="flex: 0 0 auto; width: 220px; height: 220px; border: 2px solid var(--on-dark); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center">
          <svg width="44" height="44" viewBox="0 0 34 34" aria-hidden="true"><path d="M8 17.5l5.5 5.5L26 10.5" fill="none" stroke="#F2783F" stroke-width="3"></path></svg>
          <span class="disp" style="font-size: 34px; color: #fff">ISO 9001</span>
          <span class="mono" style="color: var(--on-dark-2)">2015 certified</span>
        </div>
        <div style="flex: 1 1 480px; display: flex; flex-direction: column; gap: 20px">
          <p class="eyebrow" style="color: var(--arc-on-dark)">Quality &amp; certification</p>
          <h2 class="disp h2" style="color: #fff">Quality you can audit.</h2>
          <p class="lead" style="color: var(--on-dark-2); max-width: 640px">ATA Industries runs an ISO 9001:2015 certified quality management system, AWS D1.1 welding, heat certifications and lot traceability from raw stock to finished assembly. OEM customers are welcome to audit our systems directly.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px 28px">
            <a class="link-arrow link-arrow-dark" href="#" aria-disabled="true" data-unavailable title="[Document to be supplied]">Download ISO certificate (PDF) <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
            <a class="link-arrow link-arrow-dark" href="/quote/">Our quality process <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6cqi, 96px)">
        <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 20px; max-width: 440px">
          <p class="eyebrow">Data center FAQ</p>
          <h2 class="disp h2">Common questions from data center OEMs.</h2>
        </div>
        <div style="flex: 2 1 560px">
          {faqs.map((f, index) => ( <Fragment>
            <div class="faq-item">
              <h3 style="margin: 0"><button type="button" class="faq-q" id={`faq-question-${index}`} aria-expanded={f.expanded} data-faq-toggle aria-controls={`faq-answer-${index}`}>{f.q}<span class="faq-icon">
                <span data-faq-minus hidden={!f.open}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7h10"></path></svg></span>
                <span data-faq-plus hidden={f.open}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7h10M7 2v10"></path></svg></span>
              </span></button></h3>
              <div data-faq-answer id={`faq-answer-${index}`} role="region" aria-labelledby={`faq-question-${index}`} hidden={!f.open}><p class="faq-a">{f.a}</p></div>
            </div>
          </Fragment> ))}
        </div>
      </div>
    </section>
  </main>
  <CtaBand />
  <Footer />
</div>
</BaseLayout>
