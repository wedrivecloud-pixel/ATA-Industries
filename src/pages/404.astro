---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---
<BaseLayout title="Page not found" description="Find your way back to ATA Industries services, equipment and project enquiries.">
<div class="ata" style="background: #fff">
  <Header />
  <main id="main" tabindex="-1" style="background: var(--mill); color: #fff">
    <div class="wrap" style="padding-top: clamp(64px, 8cqi, 128px); padding-bottom: clamp(64px, 8cqi, 128px); display: flex; flex-direction: column; gap: 24px; max-width: 1360px">
      <p class="mono" style="margin: 0; color: var(--arc-on-dark)">Error 404 · Out of tolerance</p>
      <p class="disp" aria-hidden="true" style="font-size: clamp(120px, 18cqi, 260px); line-height: .85; color: #fff">404</p>
      <div class="rule-dark" style="max-width: 720px"></div>
      <h1 class="disp h2" style="color: #fff; max-width: 720px">This page isn't on the drawing.</h1>
      <p class="lead" style="color: var(--on-dark-2); max-width: 620px">It may have moved when LMI Manufacturing became ATA Industries. Try one of these instead.</p>
      <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px">
        <a class="btn btn-primary" href="/quote/">Request a Quote</a>
        <a class="btn btn-ghost-dark" href="/">Home</a>
        <a class="btn btn-ghost-dark" href="/services/">Services</a>
        <a class="btn btn-ghost-dark" href="/industries/">Industries</a>
      </div>
    </div>
  </main>
  <Footer />
</div>
</BaseLayout>
