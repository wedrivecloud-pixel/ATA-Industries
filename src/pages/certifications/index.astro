---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<BaseLayout title="Certifications and qualifications" description="Review ATA Industries certification and qualification information, including placeholders for supporting documents.">
<div class="ata" style="background: #fff">
  <Header active="capabilities" />
  <main id="main" tabindex="-1">
    <section aria-labelledby="cert-title" style="background: var(--paper); border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="padding-top: 28px; padding-bottom: clamp(40px, 5cqi, 72px)">
        <nav aria-label="Breadcrumb"><ol class="crumbs" style="color: var(--steel-600)"><li><a href="/" style="color: var(--steel-600)">Home</a></li><li aria-hidden="true">/</li><li><a href="/equipment/" style="color: var(--steel-600)">Capabilities</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color: var(--ink)">Certifications &amp; Qualifications</li></ol></nav>
        <div style="max-width: 780px; display: flex; flex-direction: column; gap: 22px; padding-top: clamp(32px, 4cqi, 56px)">
          <p class="eyebrow">Certifications &amp; qualifications</p>
          <h1 id="cert-title" class="disp h1">Certified to the standards your supply chain asks for.</h1>
          <p class="lead">Upload these to your supplier portal or ask us for the latest copies with your quote.</p>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="g2" style="gap: 24px">
          <article style="border: 2px solid var(--ink); display: flex; flex-direction: column">
            <div style="background: var(--ink); color: #fff; padding: 32px; display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap">
              <div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">Quality standard</p><h2 class="disp" style="font-size: clamp(40px, 4cqi, 56px); color: #fff; margin-top: 10px">ISO 9001:2015</h2></div>
              <svg width="56" height="56" viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" fill="none" stroke="#FFFFFF" stroke-width="1.5"></rect><path d="M9 17.5l5 5L25 11" fill="none" stroke="#F2783F" stroke-width="2.5"></path></svg>
            </div>
            <div style="padding: 32px; display: flex; flex-direction: column; gap: 20px; flex: 1">
              <p class="body">A quality management system that ensures consistency, accountability and continuous improvement, verified by third-party audits.</p>
              <table class="spec-table">
                <tbody>
                  <tr><th scope="row">Certified</th><td>2025</td></tr>
                  <tr><th scope="row">Registrar</th><td>[Registrar name]</td></tr>
                  <tr><th scope="row">Certificate no.</th><td>[Number]</td></tr>
                  <tr><th scope="row">Valid through</th><td>[Expiry date]</td></tr>
                </tbody>
              </table>
              <a class="btn btn-secondary" href="#" aria-disabled="true" data-unavailable title="[Document to be supplied]" style="align-self: flex-start; margin-top: auto">Download certificate (PDF)</a>
            </div>
          </article>
          <article style="border: 2px solid var(--ink); display: flex; flex-direction: column">
            <div style="background: var(--ink); color: #fff; padding: 32px; display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; flex-wrap: wrap">
              <div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">Welding code</p><h2 class="disp" style="font-size: clamp(40px, 4cqi, 56px); color: #fff; margin-top: 10px">AWS D1.1</h2></div>
              <svg width="56" height="56" viewBox="0 0 34 34" aria-hidden="true"><rect x="1" y="1" width="32" height="32" fill="none" stroke="#FFFFFF" stroke-width="1.5"></rect><path d="M9 17.5l5 5L25 11" fill="none" stroke="#F2783F" stroke-width="2.5"></path></svg>
            </div>
            <div style="padding: 32px; display: flex; flex-direction: column; gap: 20px; flex: 1">
              <p class="body">Structural welding to the AWS D1.1 code by AWS-qualified welders, with documented procedures reviewed by a third-party welding engineer.</p>
              <table class="spec-table">
                <tbody>
                  <tr><th scope="row">Welders</th><td>AWS-qualified</td></tr>
                  <tr><th scope="row">Qualified thickness</th><td>Up to 1″ with WPSs</td></tr>
                  <tr><th scope="row">Documentation</th><td>WPS · WPQ</td></tr>
                  <tr><th scope="row">Review</th><td>Third-party welding engineer</td></tr>
                </tbody>
              </table>
              <a class="btn btn-secondary" href="/quote/" style="align-self: flex-start; margin-top: auto">Request WPS / WPQ records</a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="sec" style="background: var(--paper)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Qualifications</p>
            <h2 class="disp h2">What we're qualified to build.</h2>
          </div>
          <a class="link-arrow" href="/quality/">How our quality system works <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </div>
        <div class="g4" style="gap: 40px 32px">
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 8px"></div><h3 class="disp h4">Complex weldments</h3><p class="body small">Including large assemblies and multi-part structures.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 8px"></div><h3 class="disp h4">Robotic welding</h3><p class="body small">For consistent, repeatable results on production runs.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 8px"></div><h3 class="disp h4">Internal quality checks</h3><p class="body small">Tight tolerances and consistent performance across production runs.</p></div>
          <div style="display: flex; flex-direction: column; gap: 10px"><div class="rule" style="margin-bottom: 8px"></div><h3 class="disp h4">Transparent pricing</h3><p class="body small">Upfront pricing supported by accurate quoting systems.</p></div>
        </div>
      </div>
    </section>
  </main>
  <CtaBand />
  <Footer />
</div>
</BaseLayout>
