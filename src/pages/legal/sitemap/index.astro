---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
---
<BaseLayout title="Sitemap" description="Browse the ATA Industries services, industries, company and legal pages.">
<div class="ata" style="background: #fff">
  <Header />
  <main id="main" tabindex="-1">
    <!-- SITEMAP VARIANT -->
    <section aria-labelledby="sm-title" style="background: var(--paper); border-top: 1px solid var(--steel-200); padding-top: clamp(48px, 6cqi, 88px); padding-bottom: clamp(48px, 6cqi, 88px)">
      <div class="wrap">
        <p class="eyebrow" style="margin-bottom: 14px">Variant · HTML sitemap page</p>
        <h1 id="sm-title" class="disp h2" style="margin-bottom: 36px">Sitemap</h1>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); gap: 32px">
          <div><p class="mono" style="margin: 0 0 14px; color: var(--steel-600)">Services</p><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px"><li><a href="/services/">All services</a></li><li><a href="/services/laser-cutting/">Laser Cutting</a></li><li><a href="/services/#forming">Forming</a></li><li><a href="/services/#welding">Welding</a></li><li><a href="/services/#machining">Machining</a></li><li><a href="/services/#assembly">Assembly</a></li><li><a href="/services/#punching">Sheet Metal Punching</a></li><li><a href="/services/#roll-forming">Roll Forming</a></li><li><a href="/services/#panel-bending">Panel Bending</a></li><li><a href="/services/#finishing">Finishing &amp; Powder Coating</a></li></ul></div>
          <div><p class="mono" style="margin: 0 0 14px; color: var(--steel-600)">Industries</p><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px"><li><a href="/industries/">All industries</a></li><li><a href="/industries/#electrical">Electrical &amp; Power Distribution</a></li><li><a href="/industries/data-centers/">Data Centers</a></li><li><a href="/industries/#food-processing">Food Processing</a></li><li><a href="/industries/#industrial-machinery">Industrial Machinery</a></li><li><a href="/industries/#material-handling">Material Handling &amp; Logistics</a></li><li><a href="/industries/#agriculture">Agriculture</a></li><li><a href="/industries/#oem">OEM</a></li></ul></div>
          <div><p class="mono" style="margin: 0 0 14px; color: var(--steel-600)">Capabilities</p><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px"><li><a href="/equipment/">Equipment &amp; Technology</a></li><li><a href="/facility/">Facility</a></li><li><a href="/quality/">Quality Assurance</a></li><li><a href="/certifications/">Certifications</a></li></ul></div>
          <div><p class="mono" style="margin: 0 0 14px; color: var(--steel-600)">Company</p><ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px"><li><a href="/about/">About</a></li><li><a href="/careers/">Careers</a></li><li><a href="/blog/">Blog</a></li><li><a href="/service-area/">Service Area</a></li><li><a href="/quote/">Request a Quote</a></li><li><a href="/legal/privacy/">Privacy Policy</a></li><li><a href="/legal/cookies/">Cookie Policy</a></li></ul></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</div>
</BaseLayout>
