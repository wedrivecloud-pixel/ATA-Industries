---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import CtaBand from "../../components/CtaBand.astro";
---
<BaseLayout title="Service area" description="Explore ATA Industries service area, Hartford location, Wisconsin manufacturing support and nationwide project enquiries.">
<div class="ata" style="background: #fff">
  <Header active="about" />
  <main id="main" tabindex="-1">
    <section aria-labelledby="sa-title" style="border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="padding-top: 28px"><nav aria-label="Breadcrumb"><ol class="crumbs" style="color: var(--steel-600)"><li><a href="/" style="color: var(--steel-600)">Home</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color: var(--ink)">Service Area</li></ol></nav></div>
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 5cqi, 80px); align-items: stretch; padding-top: clamp(32px, 4cqi, 56px); padding-bottom: clamp(48px, 6cqi, 88px)">
        <div style="flex: 1 1 460px; display: flex; flex-direction: column; gap: 24px; justify-content: center">
          <p class="eyebrow">Service area</p>
          <h1 id="sa-title" class="disp h1">Located in Hartford, Wisconsin. Serving OEMs nationwide.</h1>
          <p class="lead">A central Midwest location means reliable shipping and predictable lead times for regional and national customers alike.</p>
          <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px">
            <a class="btn btn-primary" href="/quote/">Request a Quote</a>
            <a class="btn btn-secondary" href="tel:+12626295527">Call (262) 629-5527</a>
          </div>
        </div>
        <div style="flex: 1 1 520px; display: flex; flex-direction: column">
          <div class="ph ph-light" style="flex: 1; min-height: 380px; align-items: center; justify-content: center; text-align: center">[Map: Midwest with Hartford, WI pinned · static SVG or image, no map script]</div>
          <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--ink); color: #fff">
            <div style="padding: 16px 20px; border-right: 1px solid var(--mill-line)"><p class="mono" style="margin: 0; color: var(--arc-on-dark)">Local</p><p style="margin: 4px 0 0; font-weight: 600">Wisconsin</p></div>
            <div style="padding: 16px 20px; border-right: 1px solid var(--mill-line)"><p class="mono" style="margin: 0; color: var(--arc-on-dark)">Regional</p><p style="margin: 4px 0 0; font-weight: 600">The Midwest</p></div>
            <div style="padding: 16px 20px"><p class="mono" style="margin: 0; color: var(--arc-on-dark)">National</p><p style="margin: 4px 0 0; font-weight: 600">Nationwide</p></div>
          </div>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Cities we serve</p>
            <h2 class="disp h2">Wisconsin metal fabrication, close to home.</h2>
          </div>
          <p class="body" style="max-width: 440px">Each city page uses this template with local copy, a map pin and drive-time details.</p>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px">
          <a class="ind-tile" href="/quote/"><span class="ind-name" style="min-height: 88px; font-size: 20px"><span>Milwaukee<span class="mono" style="display: block; color: var(--steel-600); margin-top: 6px">Wisconsin</span></span><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/" style="border-color: var(--ink)"><span class="ind-name" style="min-height: 88px; font-size: 20px"><span>Hartford<span class="mono" style="display: block; color: var(--arc); margin-top: 6px">Headquarters</span></span><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><span class="ind-name" style="min-height: 88px; font-size: 20px"><span>Green Bay<span class="mono" style="display: block; color: var(--steel-600); margin-top: 6px">Wisconsin</span></span><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><span class="ind-name" style="min-height: 88px; font-size: 20px"><span>Oshkosh<span class="mono" style="display: block; color: var(--steel-600); margin-top: 6px">Wisconsin</span></span><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
          <a class="ind-tile" href="/quote/"><span class="ind-name" style="min-height: 88px; font-size: 20px"><span>Fond du Lac<span class="mono" style="display: block; color: var(--steel-600); margin-top: 6px">Wisconsin</span></span><svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="flex: none"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></a>
        </div>
      </div>
    </section>

    <section class="sec" style="background: var(--paper)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px clamp(40px, 6cqi, 96px)">
        <div style="flex: 1 1 400px; display: flex; flex-direction: column; gap: 20px">
          <p class="eyebrow">Why location doesn't matter</p>
          <h2 class="disp h2">The same service, wherever you are.</h2>
          <ul style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; border-top: 1px solid var(--steel-200)">
            <li style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 2px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><span><b>Quotes in 24–48 hours</b>, no site visit needed</span></li>
            <li style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 2px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><span><b>Predictable lead times</b> of 2–3 weeks</span></li>
            <li style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 2px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><span><b>In-house processing</b> and robotic welding</span></li>
            <li style="display: flex; gap: 14px; padding: 16px 0; border-bottom: 1px solid var(--steel-200)"><svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true" style="flex: none; margin-top: 2px"><rect width="22" height="22" fill="#14181C"></rect><path d="M6 11.5l3.2 3.2L16 8" fill="none" stroke="#fff" stroke-width="2"></path></svg><span><b>Transparent pricing</b> and ISO 9001:2015 quality</span></li>
          </ul>
        </div>
        <div style="flex: 1 1 400px; background: #fff; border-top: 3px solid var(--ink); padding: clamp(28px, 3cqi, 40px); display: flex; flex-direction: column; gap: 22px">
          <p class="eyebrow">Shipping &amp; receiving</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr)); gap: 20px">
            <div><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Corporate office</p><p style="margin: 0">W352 WI-33<br>Hartford, WI 53027</p></div>
            <div><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Shipping address</p><p style="margin: 0">W352 State Highway 33<br>Hartford, WI 53027</p></div>
          </div>
          <div style="padding-top: 18px; border-top: 1px solid var(--steel-200)"><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Receiving hours</p><p style="margin: 0; font-weight: 600">Monday–Friday, 7:30 AM – 4:30 PM</p></div>
          <div style="padding-top: 18px; border-top: 1px solid var(--steel-200)"><p class="mono" style="margin: 0 0 6px; color: var(--steel-600)">Not sure if we serve your area?</p><a href="tel:+12626295527" style="font-family: var(--f-display); font-stretch: 80%; font-weight: 700; font-size: 30px; color: var(--ink); text-decoration: none">(262) 629-5527</a></div>
        </div>
      </div>
    </section>

    <section class="sec">
      <div class="wrap g2" style="gap: 48px">
        <div style="display: flex; flex-direction: column; gap: 18px">
          <p class="eyebrow">Services</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px">
            <a class="chip" href="/services/laser-cutting/">Laser Cutting</a><a class="chip" href="/services/#forming">Forming</a><a class="chip" href="/services/#panel-bending">Panel Bending</a><a class="chip" href="/quote/">Punching</a><a class="chip" href="/services/#welding">Welding</a><a class="chip" href="/services/#machining">Machining</a><a class="chip" href="/services/#assembly">Assembly</a><a class="chip" href="/quote/">Finishing</a>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 18px">
          <p class="eyebrow">Industries</p>
          <div style="display: flex; flex-wrap: wrap; gap: 8px">
            <a class="chip" href="/industries/#food-processing">Food Processing</a><a class="chip" href="/quote/">Electrical &amp; Power</a><a class="chip" href="/industries/#industrial-machinery">Industrial Machinery</a><a class="chip" href="/quote/">Material Handling</a><a class="chip" href="/industries/data-centers/">Data Centers</a><a class="chip" href="/industries/#agriculture">Agriculture</a><a class="chip" href="/industries/#oem">OEM</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <CtaBand />
  <Footer />
</div>
</BaseLayout>
