---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import CtaBand from "../../../components/CtaBand.astro";
import {designData} from "../../../data/Service-Laser";
const {faqs}=designData;
---
<BaseLayout title="Laser Cutting service" description="Review laser cutting specifications, materials and project requirements for ATA Industries\u2019 fiber laser service.">
<div class="ata" style="background: #fff">
  <Header active="services" />
  <main id="main" tabindex="-1">

    <!-- HERO -->
    <section aria-labelledby="svc-title" style="border-bottom: 1px solid var(--steel-200)">
      <div class="wrap" style="padding-top: 28px">
        <nav aria-label="Breadcrumb">
          <ol class="crumbs" style="color: var(--steel-600)">
            <li><a href="/" style="color: var(--steel-600)">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/quote/" style="color: var(--steel-600)">Services</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" style="color: var(--ink)">Laser Cutting</li>
          </ol>
        </nav>
      </div>
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 5cqi, 80px); align-items: stretch; padding-top: clamp(32px, 4cqi, 56px); padding-bottom: clamp(48px, 6cqi, 88px)">
        <div style="flex: 1 1 480px; display: flex; flex-direction: column; gap: 24px; justify-content: center">
          <p class="eyebrow">Service 01 · Fabrication</p>
          <h1 id="svc-title" class="disp h1">Precision Laser Cutting</h1>
          <p class="lead" style="max-width: 580px">Fast, clean cuts on sheet and plate with a 6kW fiber laser. Cut parts move straight to forming, welding and assembly in the same building.</p>
          <div class="stack-m" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px">
            <a class="btn btn-primary" href="/quote/">Request a Quote <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
            <a class="btn btn-secondary" href="tel:+12626295527">Call (262) 629-5527</a>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px">
            <span class="badge badge-solid">ISO 9001:2015</span>
            <span class="badge" style="color: var(--steel-700)">24–48 hr quotes</span>
            <span class="badge" style="color: var(--steel-700)">2–3 wk lead times</span>
            <span class="badge badge-arc">Rush capacity</span>
          </div>
        </div>
        <div style="flex: 1 1 520px; display: flex; flex-direction: column">
          <div class="ph" style="flex: 1; min-height: 420px">[Photo: 6kW fiber laser cutting plate, sparks visible · 4:3, ≥ 1600 px]</div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(150px, 100%), 1fr)); background: var(--ink); color: #fff">
            <div style="padding: 18px 20px; border-right: 1px solid var(--mill-line)"><p class="stat-num" style="font-size: 28px">6kW</p><p class="stat-label" style="color: var(--on-dark-2); margin-top: 6px">Fiber laser</p></div>
            <div style="padding: 18px 20px; border-right: 1px solid var(--mill-line)"><p class="stat-num" style="font-size: 28px">79″ × 158″</p><p class="stat-label" style="color: var(--on-dark-2); margin-top: 6px">Max sheet</p></div>
            <div style="padding: 18px 20px"><p class="stat-num" style="font-size: 28px">0.0004″</p><p class="stat-label" style="color: var(--on-dark-2); margin-top: 6px">Repeatability</p></div>
          </div>
        </div>
      </div>
    </section>

    <!-- SPECS -->
    <section class="sec">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 48px clamp(40px, 6cqi, 96px); align-items: flex-start">
        <div style="flex: 1.4 1 540px">
          <div class="sec-head" style="margin-bottom: 28px">
            <div>
              <p class="eyebrow">Capabilities &amp; specs</p>
              <h2 class="disp h2">What our laser can cut.</h2>
            </div>
          </div>
          <div style="overflow-x: auto">
            <table class="spec-table">
              <caption class="help" style="text-align: left; caption-side: bottom; padding-top: 14px">Specs are typical. Send your drawing and we'll confirm feasibility in the quote.</caption>
              <tbody>
                <tr><th scope="row">Machine</th><td>6kW big-bed fiber laser</td></tr>
                <tr><th scope="row">Max sheet size (X, Y)</th><td>158″ × 79″</td></tr>
                <tr><th scope="row">Max axis travel (X, Y, Z)</th><td>160″ × 81″ × 4″</td></tr>
                <tr><th scope="row">Positioning speed</th><td>4,724″/min per axis (X, Y)</td></tr>
                <tr><th scope="row">Repeatability</th><td>0.0004″</td></tr>
                <tr><th scope="row">Materials &amp; thickness</th><td>[Max thickness by material]</td></tr>
                <tr><th scope="row">Quantities</th><td>[Prototype to production volumes]</td></tr>
                <tr><th scope="row">Secondary ops</th><td>Forming, welding, machining, assembly in-house</td></tr>
              </tbody>
            </table>
          </div>
        </div>
        <aside style="flex: 1 1 340px; background: var(--paper); border-top: 3px solid var(--ink); padding: 32px; display: flex; flex-direction: column; gap: 18px">
          <p class="mono" style="margin: 0; color: var(--steel-600)">Ready to quote?</p>
          <h3 class="disp h3">Send your flat pattern or 3D model.</h3>
          <p class="body small">SolidWorks preferred. Include material, thickness, quantity and needed-by date. We'll respond within 24–48 hours.</p>
          <a class="btn btn-primary" href="/quote/">Upload drawings</a>
          <a class="link-arrow" href="#" aria-disabled="true" data-unavailable title="[Document to be supplied]" style="align-self: flex-start; font-size: 15px">Download capabilities sheet (PDF) <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </aside>
      </div>
    </section>

    <!-- BENEFITS -->
    <section class="sec" style="background: var(--mill); color: var(--on-dark)">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow" style="color: var(--arc-on-dark)">Why laser cut with ATA Industries</p>
            <h2 class="disp h2" style="color: #fff">Cut parts that are ready for the next step.</h2>
          </div>
        </div>
        <div class="g4" style="gap: 40px 32px">
          <div style="display: flex; flex-direction: column; gap: 12px"><div class="rule-dark" style="margin-bottom: 8px"></div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">01</p><h3 class="disp h4" style="color: #fff">Full-size sheets</h3><p class="body small" style="color: var(--on-dark-2)">A 79″ × 158″ bed handles large panels and nests more parts per sheet.</p></div>
          <div style="display: flex; flex-direction: column; gap: 12px"><div class="rule-dark" style="margin-bottom: 8px"></div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">02</p><h3 class="disp h4" style="color: #fff">Fiber laser speed</h3><p class="body small" style="color: var(--on-dark-2)">6kW of fiber power keeps cutting time, and your lead time, short.</p></div>
          <div style="display: flex; flex-direction: column; gap: 12px"><div class="rule-dark" style="margin-bottom: 8px"></div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">03</p><h3 class="disp h4" style="color: #fff">No supplier handoff</h3><p class="body small" style="color: var(--on-dark-2)">Cut blanks go straight to forming, welding and assembly under one roof.</p></div>
          <div style="display: flex; flex-direction: column; gap: 12px"><div class="rule-dark" style="margin-bottom: 8px"></div><p class="mono" style="margin: 0; color: var(--arc-on-dark)">04</p><h3 class="disp h4" style="color: #fff">Certified quality</h3><p class="body small" style="color: var(--on-dark-2)">Every job runs under our ISO 9001:2015 quality management system.</p></div>
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Recent laser-cut work</p>
            <h2 class="disp h2">Parts off the table.</h2>
          </div>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 16px">
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
          <figure style="margin: 0; display: flex; flex-direction: column; gap: 8px"><div class="ph" style="aspect-ratio: 4 / 3">[Photo]</div><figcaption class="help">[Part type · material · thickness]</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- RELATED INDUSTRIES -->
    <section class="sec" style="background: var(--paper); padding-top: clamp(56px, 6cqi, 88px); padding-bottom: clamp(56px, 6cqi, 88px)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 24px 64px; align-items: center">
        <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 14px">
          <p class="eyebrow">Industries we cut for</p>
          <h2 class="disp h3">Laser-cut parts for every industry we serve.</h2>
        </div>
        <div style="flex: 2 1 560px; display: flex; flex-wrap: wrap; gap: 10px">
          <a class="chip" href="/industries/#electrical">Electrical &amp; Power Distribution</a>
          <a class="chip" href="/industries/data-centers/">Data Centers</a>
          <a class="chip" href="/industries/#food-processing">Food Processing</a>
          <a class="chip" href="/industries/#industrial-machinery">Industrial Machinery</a>
          <a class="chip" href="/industries/#material-handling">Material Handling &amp; Logistics</a>
          <a class="chip" href="/industries/#agriculture">Agriculture</a>
          <a class="chip" href="/industries/#oem">OEM</a>
        </div>
      </div>
    </section>

    <!-- RELATED SERVICES -->
    <section class="sec">
      <div class="wrap">
        <div class="sec-head">
          <div>
            <p class="eyebrow">Related services</p>
            <h2 class="disp h2">What happens after the cut.</h2>
          </div>
          <a class="link-arrow" href="/quote/">All services <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></a>
        </div>
        <div class="g3">
          <a class="card" href="/quote/"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: press brake forming]</div><div class="card-body"><span class="mono" style="color: var(--steel-600)">02</span><h3 class="disp h4">Forming &amp; Bending</h3><p class="body small">Press brake forming for consistent, repeatable angles.</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/services/#welding"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: robotic weld cell]</div><div class="card-body"><span class="mono" style="color: var(--steel-600)">03</span><h3 class="disp h4">Welding</h3><p class="body small">Certified manual and robotic welding up to 1″ thick.</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
          <a class="card" href="/services/#assembly"><div class="ph" style="aspect-ratio: 16 / 9">[Photo: assembly]</div><div class="card-body"><span class="mono" style="color: var(--steel-600)">05</span><h3 class="disp h4">Assembly</h3><p class="body small">Sub-assemblies to finished units, ready for your line.</p><span class="card-cta">Explore <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"></path></svg></span></div></a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" style="border-top: 1px solid var(--steel-200)">
      <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 40px clamp(40px, 6cqi, 96px)">
        <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 20px; max-width: 440px">
          <p class="eyebrow">Laser cutting FAQ</p>
          <h2 class="disp h2">Before you send a drawing.</h2>
        </div>
        <div style="flex: 2 1 560px">
          {faqs.map((f, index) => ( <Fragment>
            <div class="faq-item">
              <h3 style="margin: 0"><button type="button" class="faq-q" id={`faq-question-${index}`} aria-expanded={f.expanded} data-faq-toggle aria-controls={`faq-answer-${index}`}>{f.q}<span class="faq-icon">
                <span data-faq-minus hidden={!f.open}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7h10"></path></svg></span>
                <span data-faq-plus hidden={f.open}><svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M2 7h10M7 2v10"></path></svg></span>
              </span></button></h3>
              <div data-faq-answer id={`faq-answer-${index}`} role="region" aria-labelledby={`faq-question-${index}`} hidden={!f.open}><p class="faq-a">{f.a}</p></div>
            </div>
          </Fragment> ))}
        </div>
      </div>
    </section>
  </main>
  <CtaBand />
  <Footer />
</div>
</BaseLayout>
