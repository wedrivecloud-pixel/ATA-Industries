---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {brand} from '../config/brand';
interface Props {title:string; description:string; schema?:Record<string,unknown>}
const {title,description,schema}=Astro.props;
const url=new URL(Astro.url.pathname,brand.url).href;
const graph=[{'@type':'Organization',name:brand.name,url:brand.url},...(Astro.url.pathname==='/'?[]:[{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:brand.url},{'@type':'ListItem',position:2,name:title,item:url}]}]),...(schema?[schema]:[])];
---
<BaseLayout title={title} description={description} schema={{'@context':'https://schema.org','@graph':graph}}>
<Header slot="header" />
<div class="review-notice">STAKEHOLDER PREVIEW <span>Proposed capabilities · Company details awaiting approval</span></div>
{Astro.url.pathname!=='/' && <div class="wrap breadcrumbs"><a href="/">Home</a><span aria-hidden="true"> / </span><span>{title}</span></div>}
<slot />
<Footer slot="footer" />
</BaseLayout>
